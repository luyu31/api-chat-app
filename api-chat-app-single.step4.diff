+          : 0;
+        if (!chapters.has(chapter)) chapters.set(chapter, []);
+        chapters.get(chapter).push(message);
+      }
+      for (const [chapter, messages] of chapters) {
+        lines.push('## 第 ' + (chapter + 1) + ' 章', '');
+        for (const message of messages) {
+          const content = normalizeExportText(message.content);
+          if (message.role === 'user') lines.push('> 指令：' + content.replace(/\n/g, '\n> '), '');
